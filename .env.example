# Nuclear AO3 Environment Configuration

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# production or development. In production the app refuses to start on
# example settings (like the passwords below, or email links to localhost).
# On your own computer, set development (make dev-setup does this for you).
ENVIRONMENT=production

# Domain configuration
DOMAIN=localhost
DEV_DOMAIN=dev.localhost

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL
DATABASE_URL=postgres://ao3_user:ao3_password@postgres:5432/ao3_nuclear?sslmode=disable
POSTGRES_DB=ao3_nuclear
POSTGRES_USER=ao3_user
POSTGRES_PASSWORD=ao3_password

# =============================================================================
# SEARCH CONFIGURATION
# =============================================================================


# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================

# Login signing key. Create it once with "make keys", save a copy somewhere
# outside this server (password manager, offline storage), then set the path
# as the app sees it. With Docker Compose the ./secrets folder is /secrets.
# The server will not start without it. See docs/RUNBOOK.md.
SIGNING_KEY_FILE=
# Old key files still accepted for checking logins, comma-separated. Used only
# during a planned key change; remove them after 14 days. Leave empty after a
# suspected leak.
SIGNING_KEY_PREVIOUS_FILES=
# Separate key for the ID tokens given to other apps ("Sign in with the
# archive"). Recommended: without it the login key is used and a warning is
# logged. Make it with "make keys-oidc" and set its path here.
OIDC_SIGNING_KEY_FILE=
# On Linux, set this to your user id (run: id -u) so the app can read the key
# file, which only its owner may read.
# APP_UID=1001
JWT_ISSUER=nuclear-ao3

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================

# The backend is one program (backend/cmd/nuclear).
PORT=8080            # API port inside the container (published on localhost:8088)
METRICS_ADDR=:9091   # Prometheus metrics; never expose this publicly
FRONTEND_PORT=3000

# Extra browser origins allowed to call the API (comma-separated).
# Not needed in production, where the frontend and API share one domain.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend API Gateway URL (leave empty for production, set to http://localhost:8088 for development)
NEXT_PUBLIC_API_GATEWAY_URL=

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# SMTP Configuration (for MailHog in development, use real SMTP in production)
SMTP_HOST=smtp
SMTP_PORT=1025
SMTP_FROM=noreply@nuclear-ao3.local
SMTP_FROM_NAME=Nuclear AO3

# To try the archive out with no email service (see docs/HOSTING.md):
# TRIAL_NO_EMAIL=true
# ...and to fill it once with made-up accounts and works, at the next start.
# Needs TRIAL_NO_EMAIL=true. Anyone who knows the password can log in as
# demo01@example.org to demo25@example.org, so choose a real one (12 to 40
# characters). Remove DEMO_DATA after the first start.
# DEMO_DATA=true
# DEMO_PASSWORD=

# For production, use real SMTP:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-sendgrid-api-key

# The archive's public address, for links in emails (no trailing slash)
SITE_URL=http://localhost

# How many background jobs (such as emails) run at once
JOB_WORKERS=2

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================

# Grafana (dashboards). Required: Docker Compose will not start without it.
# Make a long random one with:  openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# Optional: email alerts. Leave empty to turn them off. See docs/MONITORING.md.
# ALERT_EMAIL_TO=you@example.org
# GF_SMTP_ENABLED=true
# GF_SMTP_HOST=smtp.example.org:587
# GF_SMTP_USER=
# GF_SMTP_PASSWORD=
# GF_SMTP_FROM_ADDRESS=alerts@example.org

# =============================================================================
# PRODUCTION OVERRIDES
# =============================================================================

# Production domain (override in production .env)
# DOMAIN=nuclear-ao3.com

# Production secrets (MUST be changed in production)
# POSTGRES_PASSWORD=generate-a-secure-password-here

# =============================================================================
# BLUE-GREEN DEPLOYMENT
# =============================================================================

# Deployment configuration for blue-green
DEPLOY_COLOR=blue
DEPLOYMENT_TIMESTAMP=
SERVICE_PREFIX=nuclear-ao3

# =============================================================================
# OFF-SERVER BACKUPS (optional, strongly recommended; see docs/BACKUPS.md)
# =============================================================================
# Leave OFFSITE_REPOSITORY empty and backups stay on this server only.
# Any restic repository address works, for example:
#   s3:https://s3.example.com/my-bucket/nuclear   b2:my-bucket:nuclear
#   sftp:user@host:/path   rest:https://host:8000/nuclear
# OFFSITE_REPOSITORY=
# The repository password: a file inside secrets/. 'make offsite-init' creates
# it. Save a copy of it somewhere other than this server.
# OFFSITE_PASSWORD_FILE=secrets/offsite-password
# Your storage provider login, one KEY=VALUE per line, no quotes, in a file
# inside secrets/ (for example AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY, or
# B2_ACCOUNT_ID and B2_ACCOUNT_KEY).
# OFFSITE_ENV_FILE=secrets/offsite.env
