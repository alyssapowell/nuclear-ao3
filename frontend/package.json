{
  "name": "nuclear-ao3-frontend",
  "version": "0.1.0",
  "description": "The Nuclear AO3 website: a single-page app built to plain files and served by Caddy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "update-attributions": "node scripts/update-attributions.cjs"
  },
  "dependencies": {
    "@headlessui/react": "2.2.9",
    "@heroicons/react": "2.2.0",
    "@tiptap/extension-link": "3.7.0",
    "@tiptap/extension-placeholder": "3.7.0",
    "@tiptap/react": "3.7.0",
    "@tiptap/starter-kit": "3.7.0",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "dompurify": "3.4.17",
    "lodash.debounce": "4.0.8",
    "lucide-react": "0.544.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/lodash.debounce": "4.0.9",
    "@types/node": "20.19.20",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "jsdom": "26.1.0",
    "msw": "2.11.6",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
